# ─────────────────────────────────────────────────────────
# JD-Agent 环境变量配置
# ─────────────────────────────────────────────────────────
# 复制此文件为 .env 并填写:
#   copy .env.example .env
# ─────────────────────────────────────────────────────────

# ── LLM API Key（三选一，优先级从左到右） ──
# 1. DeepSeek（推荐）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2. OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1

# 3. 通义千问（DashScope）
# DASHSCOPE_API_KEY=sk-xxx

# ── 模型配置 ──
# DEFAULT_MODEL=deepseek-chat        # DeepSeek
# DEFAULT_MODEL=gpt-4o-mini          # OpenAI
# DEFAULT_MODEL=qwen-plus            # 通义千问

# ── 运行时配置 ──
# API_PORT=8000                      # FastAPI 端口
# API_HOST=0.0.0.0                   # FastAPI 绑定地址
# API_RELOAD=true                    # 开发模式自动重载
# JD_AGENT_API_URL=http://127.0.0.1:8000  # Streamlit 连接 API 地址
# JD_AGENT_WORKSPACE=D:\桌面\深度学习\jd_agent  # 工作目录

# ── 并发控制 ──
# JDAGENT_MAX_CONCURRENT_REQUESTS=3  # 最大并发请求数（0=不限）

# ── Redis 缓存（可选，不配置则缓存降级，业务正常运行） ──
# REDIS_URL=redis://localhost:6379/0  # Docker 内默认连同名 service
# REDIS_PORT=6379                     # Docker Compose 中的 redis 端口

# ── PostgreSQL 数据库（可选，不配置则用 JSONL） ──
# DATABASE_URL=postgresql://jdagent:devpassword@localhost:5432/jdagent
# PG_PASSWORD=devpassword             # Docker Compose 中的 postgres 密码

# ── Delivery Agent 配送后端配置 ──
# 校园外卖配送系统后端地址（Go/Gin 后端，端口 3000）
# DELIVERY_BACKEND_URL=http://localhost:3000
